# Copy to backend/.env to override defaults. backend/.env is git-ignored.
# The Adaptive Sonar backend needs NO secrets: the simulation runs in memory.

# --- Application -------------------------------------------------------------
# development | staging | production  (production disables /api/docs)
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated allowed browser origins (not needed when using the Vite dev proxy)
CORS_ORIGINS=http://localhost:5173

# --- Simulation --------------------------------------------------------------
# Seed for all simulated randomness: same seed + same operator inputs = same run.
SIM_SEED=1729
# Real-time seconds between engine frames, and simulated seconds per frame (at 1x speed).
SIM_TICK_SECONDS=0.5
SIM_FRAME_SECONDS=0.5
# Start transmitting immediately when the server boots.
SIM_AUTOSTART=false
SIM_HISTORY_SIZE=1200
SIM_LOG_SIZE=2000

# --- Telemetry (future hardware) --------------------------------------------
# Only "simulation" is implemented. "serial" is reserved for the STM32F446RE link.
TELEMETRY_SOURCE=simulation
SERIAL_PORT=
SERIAL_BAUD=115200
