{
  "_comment": "Postal-code formats per ISO 3166-1 alpha-2 country. Source of truth for backend AND frontend (frontend/src/data/postal-codes.json must be an identical copy; a backend test enforces this). Patterns are matched against the upper-cased, whitespace-collapsed value. numeric=true means the national format uses digits only (plus the separators shown in the example), so the UI restricts input to digits. none=true means the country does not use postal codes. Countries not listed get only a generic length/character check. Based on the Universal Postal Union / Google libaddressinput formats.",
  "AR": {"pattern": "^(?:[A-HJ-NP-Z]?\\d{4}(?:[A-Z]{3})?)$", "example": "C1070AAM"},
  "AT": {"pattern": "^\\d{4}$", "example": "1010", "numeric": true},
  "AU": {"pattern": "^\\d{4}$", "example": "2000", "numeric": true},
  "BD": {"pattern": "^\\d{4}$", "example": "1000", "numeric": true},
  "BE": {"pattern": "^\\d{4}$", "example": "1000", "numeric": true},
  "BG": {"pattern": "^\\d{4}$", "example": "1000", "numeric": true},
  "BR": {"pattern": "^\\d{5}-?\\d{3}$", "example": "01310-100", "numeric": true},
  "CA": {"pattern": "^[ABCEGHJ-NPRSTVXY]\\d[ABCEGHJ-NPRSTV-Z] ?\\d[ABCEGHJ-NPRSTV-Z]\\d$", "example": "K1A 0B1"},
  "CH": {"pattern": "^\\d{4}$", "example": "8001", "numeric": true},
  "CL": {"pattern": "^\\d{3}-?\\d{4}$", "example": "8320000", "numeric": true},
  "CN": {"pattern": "^\\d{6}$", "example": "100000", "numeric": true},
  "CO": {"pattern": "^\\d{6}$", "example": "110111", "numeric": true},
  "CZ": {"pattern": "^\\d{3} ?\\d{2}$", "example": "110 00", "numeric": true},
  "DE": {"pattern": "^\\d{5}$", "example": "10115", "numeric": true},
  "DK": {"pattern": "^\\d{4}$", "example": "1050", "numeric": true},
  "EE": {"pattern": "^\\d{5}$", "example": "10111", "numeric": true},
  "EG": {"pattern": "^\\d{5}$", "example": "11511", "numeric": true},
  "ES": {"pattern": "^\\d{5}$", "example": "28001", "numeric": true},
  "FI": {"pattern": "^\\d{5}$", "example": "00100", "numeric": true},
  "FR": {"pattern": "^\\d{2} ?\\d{3}$", "example": "75008", "numeric": true},
  "GB": {"pattern": "^(?:GIR ?0AA|[A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2})$", "example": "SW1A 1AA"},
  "GR": {"pattern": "^\\d{3} ?\\d{2}$", "example": "105 57", "numeric": true},
  "HR": {"pattern": "^\\d{5}$", "example": "10000", "numeric": true},
  "HU": {"pattern": "^\\d{4}$", "example": "1051", "numeric": true},
  "ID": {"pattern": "^\\d{5}$", "example": "10110", "numeric": true},
  "IE": {"pattern": "^(?:[AC-FHKNPRTV-Y]\\d{2}|D6W) ?[0-9AC-FHKNPRTV-Y]{4}$", "example": "D02 X285"},
  "IL": {"pattern": "^\\d{5}(?:\\d{2})?$", "example": "9100001", "numeric": true},
  "IN": {"pattern": "^[1-9]\\d{2} ?\\d{3}$", "example": "110001", "numeric": true},
  "IS": {"pattern": "^\\d{3}$", "example": "101", "numeric": true},
  "IT": {"pattern": "^\\d{5}$", "example": "00144", "numeric": true},
  "JP": {"pattern": "^\\d{3}-?\\d{4}$", "example": "100-0001", "numeric": true},
  "KE": {"pattern": "^\\d{5}$", "example": "00100", "numeric": true},
  "KR": {"pattern": "^\\d{5}$", "example": "03187", "numeric": true},
  "LK": {"pattern": "^\\d{5}$", "example": "00100", "numeric": true},
  "LT": {"pattern": "^(?:LT-)?\\d{5}$", "example": "LT-01100"},
  "LU": {"pattern": "^(?:L-)?\\d{4}$", "example": "1009"},
  "LV": {"pattern": "^LV-\\d{4}$", "example": "LV-1010"},
  "MA": {"pattern": "^\\d{5}$", "example": "10000", "numeric": true},
  "MX": {"pattern": "^\\d{5}$", "example": "06600", "numeric": true},
  "MY": {"pattern": "^\\d{5}$", "example": "50450", "numeric": true},
  "NG": {"pattern": "^\\d{6}$", "example": "100001", "numeric": true},
  "NL": {"pattern": "^\\d{4} ?[A-Z]{2}$", "example": "1012 AB"},
  "NO": {"pattern": "^\\d{4}$", "example": "0150", "numeric": true},
  "NP": {"pattern": "^\\d{5}$", "example": "44600", "numeric": true},
  "NZ": {"pattern": "^\\d{4}$", "example": "6011", "numeric": true},
  "PH": {"pattern": "^\\d{4}$", "example": "1000", "numeric": true},
  "PK": {"pattern": "^\\d{5}$", "example": "44000", "numeric": true},
  "PL": {"pattern": "^\\d{2}-\\d{3}$", "example": "00-950", "numeric": true},
  "PT": {"pattern": "^\\d{4}-\\d{3}$", "example": "1000-001", "numeric": true},
  "RO": {"pattern": "^\\d{6}$", "example": "010011", "numeric": true},
  "RU": {"pattern": "^\\d{6}$", "example": "101000", "numeric": true},
  "SA": {"pattern": "^\\d{5}(?:-\\d{4})?$", "example": "11564", "numeric": true},
  "SE": {"pattern": "^\\d{3} ?\\d{2}$", "example": "111 22", "numeric": true},
  "SG": {"pattern": "^\\d{6}$", "example": "018956", "numeric": true},
  "SI": {"pattern": "^\\d{4}$", "example": "1000", "numeric": true},
  "SK": {"pattern": "^\\d{3} ?\\d{2}$", "example": "811 01", "numeric": true},
  "TH": {"pattern": "^\\d{5}$", "example": "10200", "numeric": true},
  "TR": {"pattern": "^\\d{5}$", "example": "34000", "numeric": true},
  "TW": {"pattern": "^\\d{3}(?:\\d{2,3})?$", "example": "100", "numeric": true},
  "UA": {"pattern": "^\\d{5}$", "example": "01001", "numeric": true},
  "US": {"pattern": "^\\d{5}(?:-\\d{4})?$", "example": "94105", "numeric": true},
  "VN": {"pattern": "^\\d{5,6}$", "example": "100000", "numeric": true},
  "ZA": {"pattern": "^\\d{4}$", "example": "2001", "numeric": true},
  "AE": {"none": true},
  "AO": {"none": true},
