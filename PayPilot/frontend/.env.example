# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Everything prefixed VITE_ is bundled into the browser JavaScript and is
# PUBLIC. Only put values here that are safe for anyone to see.
# NEVER put the Supabase service_role / secret key, database password,
# or any AI provider API key in this file.

# Supabase project URL: Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key - safe for the browser when Row Level Security is enabled.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Base path for API calls. Keep "/api" in development (Vite proxies it to the backend).
# In production, set to the deployed backend origin, e.g. https://api.paypilot.example/api
VITE_API_BASE_URL=/api

# Dev-only: where the Vite proxy forwards /api requests. Not bundled.
VITE_DEV_BACKEND_URL=http://localhost:8000
